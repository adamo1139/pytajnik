# Skopiuj do .env i wpisz klucz: cp .env.example .env
# Klucz OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Sprzęt: pelny = VoxCPM2 + Canary na GPU (~8 GB VRAM); lekki = wszystko na CPU (laptop bez GPU)
PYTAJNIK_SPRZET=pelny
# Głos w trybie lekkim: supertonic-F1 … F5, supertonic-M1 … M5, matcha-female, matcha-male
PYTAJNIK_GLOS_LEKKI=supertonic-F1
# PYTAJNIK_WATKI=4                      # wątki CPU dla STT i TTS w trybie lekkim

# Opcjonalnie (wartości domyślne):
# PYTAJNIK_MODEL=openai/gpt-6.1-sol     # dowolny model z OpenRouter
# PYTAJNIK_REASONING=low                # minimal / low / medium / high; puste = domyślny modelu
# BOT_CISZA=1.2                         # ile sekund ciszy kończy odpowiedź
# BOT_PRZERYWANIE=0                     # 1 = można przerywać botowi (tylko w słuchawkach)
# BOT_HOST=0.0.0.0                      # localhost = tylko ten komputer
# BOT_PORT=7860
